# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# --- App ---
PROJECT_NAME=RAILCAST
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
# Used by both the app (async) and Alembic migrations (sync) via psycopg 3.
DATABASE_URL=postgresql+psycopg://railcast:railcast@localhost:5432/railcast

# --- Cache / event streams (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- ML ---
ML_MODEL_PATH=./data/processed/models/xgboost_v1.json
MLFLOW_TRACKING_URI=./mlruns

# --- Live data providers (Phase 4) ---
# Which provider to try first, and which (if any) to try if it fails. Leave
# FALLBACK_DATA_PROVIDER empty to mean "no fallback" — the system NEVER silently
# substitutes another provider (including the simulator) unless you set this explicitly.
PRIMARY_DATA_PROVIDER=SIMULATOR
FALLBACK_DATA_PROVIDER=

NTES_ENABLED=false
RAILRADAR_ENABLED=false
SIMULATOR_ENABLED=true

# RailRadar is a third-party service, not an official Indian Railways API. Never commit
# a real key/URL here — set them in your own untracked .env only.
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=

PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_CACHE_TTL_SECONDS=30
PROVIDER_COOLDOWN_SECONDS=60

# Background polling for live ingestion is opt-in — the API works fully with this off.
LIVE_INGESTION_ENABLED=false
LIVE_INGESTION_INTERVAL_SECONDS=30

# --- Baseline ETA engine (Phase 5) ---
# RAILCAST model configuration values, NOT official Indian Railways operating rules.
BASELINE_MIN_SPEED_KMPH=15
BASELINE_MAX_SPEED_KMPH=160
BASELINE_FALLBACK_SPEED_KMPH=55
BASELINE_MAX_RECOVERY_PERCENT=5
BASELINE_MAX_RECOVERY_MINUTES_PER_SECTION=2
BASELINE_CACHE_TTL_SECONDS=30
BASELINE_STALE_STATE_MINUTES=30
BASELINE_GPS_STATION_PROXIMITY_KM=2

# --- ML residual ETA model (Phase 6) ---
ML_MODEL_ENABLED=true
ML_MODEL_DIR=./models
ML_MODEL_VERSION=
ML_RESIDUAL_MINUTES_MIN=-30
ML_RESIDUAL_MINUTES_MAX=60
ML_CACHE_TTL_SECONDS=30
ML_DATASET_PATH=./data/ml/eta_residual_dataset.parquet
ML_SYNTHETIC_DAYS=90
ML_SYNTHETIC_SEED=42
ML_XGB_MAX_DEPTH=5
ML_XGB_LEARNING_RATE=0.06
ML_XGB_N_ESTIMATORS=400
ML_SPLIT_TRAIN=0.70
ML_SPLIT_VALIDATION=0.15

# --- Network intelligence & delay propagation (Phase 8) ---
# RAILCAST analytical model configuration — NOT official Indian Railways risk
# classifications, signalling logic, or operational commands. See app/network/.
NETWORK_ANALYSIS_ENABLED=true
NETWORK_ANALYSIS_HORIZON_MINUTES=180
NETWORK_MAX_PROPAGATION_DEPTH=3
NETWORK_MIN_PROPAGATED_DELAY_MINUTES=2
NETWORK_PROPAGATION_DECAY=0.60
NETWORK_MAX_TRAINS_PER_ANALYSIS=500
NETWORK_MEDIUM_IMPACT_THRESHOLD=25
NETWORK_HIGH_IMPACT_THRESHOLD=50
NETWORK_CRITICAL_IMPACT_THRESHOLD=75
NETWORK_ALERT_THRESHOLD=60
NETWORK_MIN_SAFE_SEPARATION_MINUTES=15
NETWORK_GRAPH_CACHE_TTL_SECONDS=60
